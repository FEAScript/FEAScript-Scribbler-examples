  "jsnbversion": "v0.1",
  "cells": [
    {
      "code": "//> module\n\n/*\n * Cantilever Beam Under a Tip Load\n *\n * This example simulates the bending of a 1D Euler-Bernoulli cantilever beam\n * using the FEAScript library with the \"eulerBernoulliBeam\" model.\n *\n * The governing equation for the transverse deflection w(x) is:\n *     d²/dx² ( EI d²w/dx² ) = q(x)\n * where EI is the bending stiffness and q(x) the distributed load (here q = 0).\n *\n * The beam has a length of 4 m (domain x ∈ [0, 4]) and a bending stiffness EI = 1.0e5.\n * A mesh of 4 cubic Hermite elements is used (2 degrees of freedom per node: w and θ).\n *\n * Boundary conditions:\n *   - Clamped end (x = 0): w = 0, θ = 0\n *   - Free end    (x = 4): concentrated tip load P = -1000\n *\n * The finite element result is compared with the analytical solution\n *     w(x) = P/(6EI) (3Lx² - x³)\n *\n * For a detailed mathematical formulation and more background, see the\n * official FEAScript tutorial:\n * https://feascript.com/tutorials/cantilever-beam-1d.html\n */\n\n// Import FEAScript library\nimport { FEAScriptModel, plotSolution, version } from \"https://core.feascript.com/dist/feascript.esm.js\";\n\nconsole.log(\"FEAScript version:\", version);\n\n// Beam and load parameters\nconst beamLength = 4; // m\nconst bendingStiffness = 1.0e5; // EI\nconst tipLoad = -1000; // Downward point load at the free end\n\n// 1. Create the model and select the physics\nconst model = new FEAScriptModel();\nmodel.setModelConfig(\"eulerBernoulliBeam\", {\n  solver: { method: \"lusolve\" },\n  coefficientFunctions: {\n    EI: (x) => bendingStiffness,\n  },\n});\n\n// 2. Define the mesh\nmodel.setGeometry({ line: beamLength });\nmodel.setMeshConfig({ elementOrder: \"linear\", divisions: 4 });\n\n// 3. Apply the boundary conditions\nmodel.addBoundaryCondition(\"1\", { type: \"fixed\" });                 // Clamped support at x = 0\nmodel.addBoundaryCondition(\"5\", { type: \"force\", force: tipLoad }); // Tip point load at x = L (last node)\n\n// 4. Solve\nconst result = model.solve();\n\n// 5. Plot the results\nscrib.show(`\n  <style>\n    .feascript-example { font-family: \"Roboto\", sans-serif; color: #333; }\n    .feascript-example h1 { font-size: 1.5em; line-height: 1.2em; font-weight: normal; padding: 0.4em 0 0.2em; margin: 0 0 0.5em; color: #555; text-align: left; }\n    .feascript-example h3 { font-weight: normal; color: #555; }\n    .feascript-example .description { max-width: 600px; margin: 0 0 1em; padding: 0 1em; text-align: left; }\n    .feascript-example .description p { font-size: 1em; line-height: 1.5em; color: #555; }\n    .feascript-example .results { max-width: 600px; margin-top: 20px; }\n  </style>\n  <div class=\"feascript-example\">\n    <h1>Cantilever Beam Under a Tip Load</h1>\n    <div class=\"description\">\n      <p>This example simulates the bending of a 1D Euler-Bernoulli cantilever beam using the <a href=\"https://feascript.com/\" target=\"_blank\">FEAScript library</a>. The beam, with a length of 4 m and a bending stiffness of 1.0×10<sup>5</sup>, is clamped at x = 0 and carries a concentrated load of -1000 at its free end (x = 4 m). The finite element deflection is displayed below together with the classical analytical solution (dashed line).</p>\n    </div>\n    <div id=\"resultsCanvas\" class=\"results\"></div>\n    <div class=\"description\">\n      <p>\n        For a rigorous mathematical formulation and theory, see the\n        <a href=\"https://feascript.com/tutorials/cantilever-beam-1d.html\" target=\"_blank\">basic tutorial</a> at the FEAScript website.\n      </p>\n    </div>\n  </div>\n`);\nplotSolution(model, result, \"line\", \"resultsCanvas\");\n\n// Closed-form analytical solution w(x) = P/(6EI) * (3*L*x^2 - x^3)\nconst numAnalyticalPoints = 100;\nconst analyticalNodesX = Array.from(\n  { length: numAnalyticalPoints },\n  (_, i) => (i / (numAnalyticalPoints - 1)) * beamLength,\n);\nconst analyticalDeflection = analyticalNodesX.map(\n  (x) => (tipLoad / (6 * bendingStiffness)) * (3 * beamLength * x ** 2 - x ** 3),\n);\n\n// Add the analytical solution to the plot for comparison\nPlotly.addTraces(\"resultsCanvas\", {\n  x: analyticalNodesX,\n  y: analyticalDeflection,\n  mode: \"lines\",\n  type: \"scatter\",\n  line: { color: \"rgb(31, 119, 180)\", width: 2, dash: \"dash\" },\n  name: \"Analytical solution\",\n});\n",
      "status": "",
      "output": "",
      "type": "code"
    }
  ],
