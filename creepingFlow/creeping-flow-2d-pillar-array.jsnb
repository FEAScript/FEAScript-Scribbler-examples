  "jsnbversion": "v0.1",
  "cells": [
    {
      "code": "//> module\n\n/*\n * Creeping Flow Through a 2D Pillar Array\n *\n * This example simulates steady Stokes flow (creeping flow) in a channel with a\n * staggered array of round pillars using the FEAScript library with the\n * \"creepingFlow\" model.\n *\n * The problem is governed by the steady Stokes equations for incompressible flow:\n *     ∇ · u = 0\n *     -μ ∇²u + ∇p = 0\n * where u = (u,v) is the velocity vector, p is pressure, and μ=1.0 (dynamic viscosity).\n *\n * Domain: channel 8 × 2 with eight pillars of radius 0.3, meshed with Gmsh into\n * 2,214 quadratic triangles and solved with Taylor-Hood mixed finite elements\n * (P2 for velocity, P1 for pressure). The mesh file is fetched from the FEAScript website.\n *\n * Boundary conditions (keyed by the names of the Gmsh physical groups):\n *   - \"inlet\"   (x=0):       u=1, v=0 (uniform inflow)\n *   - \"walls\"   (y=0, y=2):  u=0, v=0 (no-slip)\n *   - \"outlet\"  (x=8):       stress-free\n *   - \"pillars\":             u=0, v=0 (no-slip)\n *\n * For a detailed mathematical formulation and more background, see the\n * official FEAScript tutorial:\n * https://feascript.com/tutorials/creeping-flow-2d-pillar-array.html\n */\n\n// Import FEAScript library\nimport {\n  FEAScriptModel,\n  importGmshMesh,\n  plotInterpolatedSolution,\n  version,\n} from \"https://core.feascript.com/dist/feascript.esm.js\";\n\nconsole.log(\"FEAScript version:\", version);\n\n// Fetch the mesh file (.msh version 4.1)\nconst meshUrl = \"https://feascript.com/tutorials/pillar_triang_quadratic.msh\";\nconst response = await fetch(meshUrl);\nif (!response.ok) {\n  throw new Error(`Failed to load mesh file: ${response.status} ${response.statusText}`);\n}\nconst meshFile = new File([await response.text()], \"pillar_triang_quadratic.msh\");\n\n// 1. Create the model and select the physics\nconst model = new FEAScriptModel();\nmodel.setModelConfig(\"creepingFlow\", {\n  solver: { method: \"lusolve\" },\n  coefficientFunctions: {\n    viscosity: 1, // μ\n  },\n});\n\n// 2. Parse the Gmsh mesh file and set the mesh\nmodel.setMesh(await importGmshMesh(meshFile));\n\n// 3. Apply the boundary conditions\nmodel.addBoundaryCondition(\"inlet\", { type: \"constantVelocity\", u: 1, v: 0 });   // Inlet\nmodel.addBoundaryCondition(\"walls\", { type: \"constantVelocity\", u: 0, v: 0 });   // Channel walls (no-slip)\nmodel.addBoundaryCondition(\"outlet\", { type: \"stressFree\" });                    // Outlet\nmodel.addBoundaryCondition(\"pillars\", { type: \"constantVelocity\", u: 0, v: 0 }); // Pillars (no-slip)\n\n// 4. Solve\nconst result = model.solve();\n\n// 5. Plot the results\nscrib.show(`\n  <style>\n    .feascript-example { font-family: \"Roboto\", sans-serif; color: #333; }\n    .feascript-example h1 { font-size: 1.5em; line-height: 1.2em; font-weight: normal; padding: 0.4em 0 0.2em; margin: 0 0 0.5em; color: #555; text-align: left; }\n    .feascript-example h3 { font-weight: normal; color: #555; }\n    .feascript-example .description { max-width: 600px; margin: 0 0 1em; padding: 0 1em; text-align: left; }\n    .feascript-example .description p { font-size: 1em; line-height: 1.5em; color: #555; }\n    .feascript-example .results { max-width: 600px; margin-top: 20px; }\n  </style>\n  <div class=\"feascript-example\">\n    <h1>Creeping Flow Through a 2D Pillar Array</h1>\n    <div class=\"description\">\n      <p>This example simulates steady-state creeping (Stokes) flow in a channel with a staggered array of eight round pillars using the <a href=\"https://feascript.com/\" target=\"_blank\">FEAScript library</a>. The fluid enters at the left with a uniform velocity, weaves between the no-slip pillars and leaves through a stress-free outlet at the right. The geometry is meshed with Gmsh into quadratic triangles, and the simulation uses Taylor-Hood mixed finite elements to solve for the velocity field.</p>\n    </div>\n    <h3>Velocity Magnitude</h3>\n    <div id=\"velocityMagnitudeCanvas\" class=\"results\"></div>\n    <div class=\"description\">\n      <p>\n        For a rigorous mathematical formulation and theory, see the\n        <a href=\"https://feascript.com/tutorials/creeping-flow-2d-pillar-array.html\" target=\"_blank\">basic tutorial</a> at the FEAScript website.\n      </p>\n    </div>\n  </div>\n`);\nplotInterpolatedSolution(model, result, \"contour\", \"velocityMagnitudeCanvas\");\n",
      "status": "",
      "output": "",
      "type": "code"
    }
  ],
  "source": "https://github.com/gopi-suvanam/scribbler",
  "run_on_load": false
}
